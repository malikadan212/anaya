{
  "buildCommand": "cd artifacts/anaya && pnpm install && pnpm run build",
  "outputDirectory": "artifacts/anaya/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
